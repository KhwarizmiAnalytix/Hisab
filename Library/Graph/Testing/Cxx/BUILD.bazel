load("//bazel:graph.bzl", "graph_copts", "graph_defines", "graph_linkopts")

package(default_visibility = ["//visibility:public"])

cc_test(
    name = "GraphCxxTests",
    size = "large",
    # Custom main (GraphTestMain.cpp, not gtest_main) -- see that file for why: on
    # macOS+ASan this binary needs to bypass a known third-party (TBB) static-destructor
    # crash at exit that is unrelated to anything these tests check.
    srcs = glob(
        ["Test*.cpp"],
        allow_empty = True,
    ) + ["GraphTestMain.cpp"],
    copts = graph_copts(),
    defines = graph_defines() + [
        "GRAPH_GOOGLE_TEST",
        "USE_GTEST",
        "_VARIADIC_MAX=10",
        "GRAPH_HAS_GTEST=1",
    ],
    includes = ["."],
    linkopts = graph_linkopts(),
    deps = [
        "//Library/Graph:Graph",
        "//Library/Graph/Testing:graphTest_header",
        "@com_google_googletest//:gtest",
    ],
)
