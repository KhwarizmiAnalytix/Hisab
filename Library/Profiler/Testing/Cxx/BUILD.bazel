# =============================================================================
# Profiler C++ tests (moved from Library/Core/Testing/Cxx)
# =============================================================================

load("//bazel:profiler.bzl", "profiler_copts", "profiler_defines", "profiler_linkopts")

package(default_visibility = ["//visibility:public"])

# =============================================================================
# Test files: must match Library/Profiler/Testing/Cxx/CMakeLists.txt TestFiles.
# Real-use-case coverage — backend function/memory/output formats, Chrome
# trace, threadpool+tracing, XPlane pipeline, heavy function, hotspot report.
# =============================================================================

_PROFILER_COMMON_TESTS = [
    "TestHotspotReport.cpp",
    "TestProfilerBackendFunction.cpp",
    "TestProfilerBackendMemory.cpp",
    "TestProfilerBackendOutput.cpp",
    "TestProfilerChromeTraceHierarchical.cpp",
    "TestProfilerHeavyFunction.cpp",
    "TestProfilerThreadpoolTracing.cpp",
    "TestProfilerXPlanePipeline.cpp",
]

cc_test(
    name = "ProfilerCxxTests",
    size = "large",
    timeout = "long",
    srcs = _PROFILER_COMMON_TESTS,
    copts = profiler_copts(),
    defines = profiler_defines() + [
        "PROFILER_GOOGLE_TEST",
        "USE_GTEST",
        "_VARIADIC_MAX=10",
        "PROFILER_HAS_GTEST=1",
    ],
    includes = ["."],
    linkopts = profiler_linkopts(),
    deps = [
        "//Library/Profiler:Profiler",
        "//Library/Profiler/Testing:profilerTest_header",
        "@com_google_googletest//:gtest",
        "@com_google_googletest//:gtest_main",
    ],
)
