# =============================================================================
# XSigma Core Library Tests BUILD Configuration
# =============================================================================
# Test targets for Core library using GoogleTest
# Equivalent to Library/Core/Testing/Cxx/CMakeLists.txt (glob + conditional excludes)
# =============================================================================

load("//bazel:xsigma.bzl", "xsigma_copts", "xsigma_defines", "xsigma_enzyme_copts", "xsigma_enzyme_linkopts", "xsigma_linkopts")

package(default_visibility = ["//visibility:public"])

# Base tests: all Test*.cpp except always-excluded and GPU/CUDA/HIP (added back via select).
_CORE_TEST_SRCS = glob(
    ["Test*.cpp"],
    exclude = [
        "TestLoggerDisableSignalHandler.cpp",
        # TestEnzymeAD.cpp added back via select when Enzyme is enabled (matches CMake CORE_ENABLE_ENZYME)
        "TestEnzymeAD.cpp",
        "TestGpu*.cpp",
        "TestGPU*.cpp",
        "TestCuda*.cpp",
        "TestHip*.cpp",
    ],
) + select({
    "//bazel:enable_enzyme": glob(["TestEnzymeAD.cpp"], allow_empty = True),
    "//conditions:default": [],
}) + select({
    "//bazel:enable_cuda": glob(
        [
            "TestGpu*.cpp",
            "TestGPU*.cpp",
            "TestCuda*.cpp",
        ],
        allow_empty = True,
    ),
    "//conditions:default": [],
}) + select({
    "//bazel:enable_hip": glob(["TestHip*.cpp"], allow_empty = True),
    "//conditions:default": [],
})

# =============================================================================
# Core Tests Target
# =============================================================================

cc_test(
    name = "CoreCxxTests",
    size = "large",
    timeout = "long",
    srcs = _CORE_TEST_SRCS,
    copts = xsigma_copts() + xsigma_enzyme_copts(),
    defines = xsigma_defines() + [
        "XSIGMA_GOOGLE_TEST",
        "USE_GTEST",
        "_VARIADIC_MAX=10",
        "XSIGMA_HAS_GTEST=1",
    ] + select({
        "//bazel:enable_cuda": ["XSIGMA_HAS_CUDA=1"],
        "//conditions:default": ["XSIGMA_HAS_CUDA=0"],
    }) + select({
        "//bazel:enable_hip": ["XSIGMA_HAS_HIP=1"],
        "//conditions:default": ["XSIGMA_HAS_HIP=0"],
    }),
    includes = ["."],
    linkopts = xsigma_linkopts() + xsigma_enzyme_linkopts(),
    deps = [
        "//Library/Core:Core",
        "//Library/Core/Testing:xsigmaTest_header",
        "@com_google_googletest//:gtest",
        "@com_google_googletest//:gtest_main",
    ],
)
